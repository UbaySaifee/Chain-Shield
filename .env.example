# ChainShield Environment Configuration Template
# Copy this file to .env and adjust as necessary

# Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev-h2
# To use PostgreSQL instead of in-memory H2, set:
# SPRING_PROFILES_ACTIVE=dev-postgres
# POSTGRES_URL=jdbc:postgresql://localhost:5432/chainshield
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Blockchain / Hardhat EVM Node
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
